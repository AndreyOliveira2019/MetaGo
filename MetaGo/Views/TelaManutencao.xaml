<Window x:Class="MetaGo.Views.TelaManutencao"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MetaGo.Views"
        mc:Ignorable="d"
        Title="Manutenção e Troca de Óleo"
        Height="700" Width="1050"
        Background="#FF3F3B3B"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="117"/>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="226.04"/>
        </Grid.RowDefinitions>

        <!-- Formulário de abastecimento -->
        <WrapPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top" Height="81">

            <Label Content="Data Manutenção:"/>
            <DatePicker Name="dpDataManutencao" Width="106" Margin="0,5,0,0" Height="27"/>

            <Rectangle Width="15" Height="0" />

            <Label Content="Serviço:"/>
            <ComboBox Name="cbTipoServico" Width="118" Margin="5"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="Troca de Óleo"/>
                <ComboBoxItem Content="Troca de Óleo + Filtro"/>
                <ComboBoxItem Content="Troca de Óleo + Filtro"/>
                <ComboBoxItem Content="Troca Pastilha de Freio Dianteiro"/>
                <ComboBoxItem Content="Troca Pastilha de Freio Traseiro"/>
                <ComboBoxItem Content="Pneu Dianteiro"/>
                <ComboBoxItem Content="Pneu Traseiro"/>
                <ComboBoxItem Content="Bateria"/>
                <ComboBoxItem Content="Troca de Óleo + Filtro"/>
            </ComboBox>

            <Rectangle Width="25" Height="0" />

            <Label Content="Combustível:"
                   VerticalContentAlignment="Center"
                   VerticalAlignment="Center"/>
            <ComboBox Name="cbTipoCombustivel" Width="118" Margin="5"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="Etanol"/>
                <ComboBoxItem Content="Gasolina Comum"/>
                <ComboBoxItem Content="Gasolina Aditivada"/>
            </ComboBox>

            <Rectangle Width="40" Height="0" />

            <Label Content="Preço do Litro (R$):" Width="130"/>
            <TextBox x:Name="txtValorLitro" Width="65"/>

            <Rectangle Width="25" Height="0" />

            <Label Content="Valor Abastecido (R$):" Width="145"/>
            <TextBox x:Name="txtValorAbastecido" Width="65"/>

            <Rectangle Width="25" Height="0" />

            <Label Content="Litros:"/>
            <TextBox x:Name="txtLitros" Width="58"/>

            <Rectangle Width="25" Height="0" />

            <Button Content="Registrar" Click="OnRegistrarAbastecimentoClicked"/>
        </WrapPanel>


        <!-- ListView de registros -->
        <ListView Name="lvAbastecimentos" Grid.Row="1" Margin="0,10,0,10"
                  BorderThickness="2"
                  BorderBrush="#2196F3">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Data" Width="100" DisplayMemberBinding="{Binding DataAbastecimento, StringFormat={}{0:dd/MM/yyyy}}"/>
                    <GridViewColumn Header="Posto" Width="280" DisplayMemberBinding="{Binding NomePosto}"/>
                    <GridViewColumn Header="Tipo" Width="120" DisplayMemberBinding="{Binding TipoCombustivel}"/>
                    <GridViewColumn Header="R$/L" Width="100" DisplayMemberBinding="{Binding ValorLitro, StringFormat={} R$ {0:F4}}"/>
                    <GridViewColumn Header="Valor Abastecido" Width="100" DisplayMemberBinding="{Binding ValorAbastecido, StringFormat={} R$ {0:F2}}"/>
                    <GridViewColumn Header="Litros" Width="100" DisplayMemberBinding="{Binding LitrosAbastecidos}"/>
                    <GridViewColumn Header="Autonomia" Width="100" DisplayMemberBinding="{Binding AutonomiaKm}"/>
                    <GridViewColumn Header="Km/L" Width="100" DisplayMemberBinding="{Binding KmPorLitro, StringFormat={}{0:F2}}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Parte inferior: registrar autonomia e mostrar cards -->
        <StackPanel Grid.Row="2" Margin="0,5,0,39">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Label Content="Autonomia (km):"/>
                <TextBox Name="txtAutonomia" Width="100"/>
                <Button Content="Registrar Autonomia" Click="OnRegistrarAutonomiaClicked"/>

                <Button Content="Remover Selecionado"
                        Width="150"
                        Height="30"
                        Margin="370,0,0,0"
                        Click="OnRemoverSelecionadoClicked"/>
                <Button Content="Limpar Todos"
                        Width="100"
                        Height="30"
                        Click="OnLimparTodosClicked"/>
            </StackPanel>

            <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                <Border Background="#555" CornerRadius="10" Margin="5" Padding="10">
                    <TextBlock Name="lblPostoMaisBarato" Foreground="White" FontWeight="Bold" Text="Posto mais barato:"/>
                </Border>
                <Border Background="#555" CornerRadius="10" Margin="5" Padding="10">
                    <TextBlock Name="lblMaisUsado" Foreground="White" FontWeight="Bold" Text="Mais utilizado:"/>
                </Border>
                <Border Background="#555" CornerRadius="10" Margin="5" Padding="10">
                    <TextBlock Name="lblMelhorCustoBeneficio" Foreground="White" FontWeight="Bold" Text="Melhor custo:"/>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
